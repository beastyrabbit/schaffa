# Public URLs only; no secrets belong in this file.
MUMPITZ_APP_BASE_URL=https://mumpitz.example.com
MUMPITZ_API_BASE_URL=https://mumpitz-api.example.com
MUMPITZ_PUBLIC_BASE_URL=https://mumpitz-cdn.example.com
MUMPITZ_DATA_DIR=/data
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
MAX_PAGE_BYTES=2097152
MAX_FILE_BYTES=268435456
IMAGE_MAX_INPUT_PIXELS=40000000
IMAGE_MAX_EDGE=2560
IMAGE_WEBP_QUALITY=82
MAX_PUBLISHED_IMAGE_BYTES=8388608

# Supply these through the deployment's secret manager at runtime.
MUMPITZ_TOKEN_PEPPER=
MUMPITZ_BOOTSTRAP_TOKEN=
